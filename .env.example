GROQ_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
FAL_KEY=""
FAL_API_KEY=""
TAVILY_API_KEY=""
SERPER_API_KEY=""
EXA_API_KEY=""
FIRECRAWL_API_KEY=""
FAL_KEY=""
FAL_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# Security Configurations
# JWT_SECRET: Secret key used for signing secure user access tokens on the server (min 32 chars).
JWT_SECRET=""
# JWT_REFRESH_SECRET: Secret key used for signing secure long-lived refresh tokens (min 32 chars).
JWT_REFRESH_SECRET=""
# DB_ENCRYPTION_KEY: Symmetric key used for encrypting database backups at rest (min 16 chars).
DB_ENCRYPTION_KEY=""
# ADMIN_EMAILS: Comma-separated list of administrative email addresses.
ADMIN_EMAILS="shivamguptaddp6312@gmail.com"

