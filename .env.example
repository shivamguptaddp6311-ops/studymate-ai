# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# Optional additional AI Provider keys
OPENAI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
FAL_KEY=""
FAL_API_KEY=""
TAVILY_API_KEY=""
SERPER_API_KEY=""
EXA_API_KEY=""
FIRECRAWL_API_KEY=""
FAL_KEY=""
FAL_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# Security Configurations
# JWT_SECRET: Secret key used for signing secure user access tokens on the server (min 32 chars).
JWT_SECRET=""
# JWT_REFRESH_SECRET: Secret key used for signing secure long-lived refresh tokens (min 32 chars).
JWT_REFRESH_SECRET=""
# DB_ENCRYPTION_KEY: Symmetric key used for encrypting database backups at rest (min 16 chars).
DB_ENCRYPTION_KEY=""
# Admin & Rate Limiting Configurations
ADMIN_EMAILS=""
AI_RATE_LIMIT_ENABLED="true"
AI_RATE_LIMIT_BURST_MAX="10"
AI_RATE_LIMIT_BURST_WINDOW_MS="60000"
AI_RATE_LIMIT_SUSTAINED_MAX="60"
AI_RATE_LIMIT_SUSTAINED_WINDOW_MS="900000"
AI_IMAGE_RATE_LIMIT_BURST_MAX="5"
AI_IMAGE_RATE_LIMIT_BURST_WINDOW_MS="60000"
AI_IMAGE_RATE_LIMIT_SUSTAINED_MAX="20"
AI_IMAGE_RATE_LIMIT_SUSTAINED_WINDOW_MS="900000"

# Firebase Client Configurations
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Cloud SQL Configurations
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""



