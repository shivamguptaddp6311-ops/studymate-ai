<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 500' width='600' height='500'>
  <defs>
    <radialGradient id='bgGrad' cx='50%' cy='50%' r='50%'>
      <stop offset='0%' stop-color='#1e293b' stop-opacity='0.6'/>
      <stop offset='100%' stop-color='#0f172a' stop-opacity='0'/>
    </radialGradient>
    <filter id='glow' x='-20%' y='-20%' width='140%' height='140%'>
      <feGaussianBlur stdDeviation='6' result='blur'/>
      <feComposite in='SourceGraphic' in2='blur' operator='over'/>
    </filter>
  </defs>

  <!-- Background grid & glow -->
  <rect width='600' height='500' fill='url(#bgGrad)' />
  <circle cx='300' cy='250' r='220' fill='none' stroke='#334155' stroke-width='1' stroke-dasharray='4,4' opacity='0.4'/>

  <!-- Human Brain Silhouette Vector Structure -->
  <g transform='translate(50, 20)' filter='url(#glow)'>
    <!-- Cerebrum Outer Contour -->
    <!-- Frontal Lobe (Red/Pink Accent) -->
    <path d='M 120,240 C 90,200 90,120 160,70 C 220,30 300,30 360,70 C 420,110 440,170 420,220 C 400,260 360,280 320,280 C 280,280 260,260 220,270 C 180,280 140,270 120,240 Z' 
          fill='#131d36' stroke='#ffffff' stroke-width='3.5' stroke-linejoin='round'/>

    <!-- Frontal Lobe Region Overlay -->
    <path d='M 130,220 C 100,180 110,110 170,75 C 220,45 270,50 270,120 C 270,180 230,230 180,240 Z' 
          fill='#ef4444' fill-opacity='0.25' stroke='#ef4444' stroke-width='2'/>

    <!-- Parietal Lobe Region Overlay -->
    <path d='M 270,50 C 330,45 380,80 395,140 C 370,160 310,160 270,120 Z' 
          fill='#a855f7' fill-opacity='0.25' stroke='#a855f7' stroke-width='2'/>

    <!-- Occipital Lobe Region Overlay -->
    <path d='M 395,140 C 425,180 415,230 380,250 C 350,220 360,170 395,140 Z' 
          fill='#22c55e' fill-opacity='0.25' stroke='#22c55e' stroke-width='2'/>

    <!-- Temporal Lobe Region Overlay -->
    <path d='M 180,240 C 210,180 280,180 300,220 C 310,250 260,280 200,275 Z' 
          fill='#06b6d4' fill-opacity='0.25' stroke='#06b6d4' stroke-width='2'/>

    <!-- Cerebellum Region Overlay -->
    <path d='M 320,280 C 360,270 410,280 400,340 C 370,380 310,370 300,330 C 295,300 310,285 320,280 Z' 
          fill='#ec4899' fill-opacity='0.3' stroke='#ec4899' stroke-width='2'/>
    <!-- Cerebellum Folia Patterns -->
    <path d='M 320,300 Q 360,310 390,300 M 315,320 Q 355,330 385,320 M 310,340 Q 350,350 375,340' 
          fill='none' stroke='#f472b6' stroke-width='1.5' opacity='0.7'/>

    <!-- Brain Stem Region Overlay -->
    <path d='M 250,280 L 285,280 L 275,410 L 235,410 Z' 
          fill='#f59e0b' fill-opacity='0.35' stroke='#f59e0b' stroke-width='2'/>

    <!-- Internal Gyri / Sulci Folds Lines -->
    <path d='M 170,110 C 200,140 220,90 250,130 M 150,160 C 190,170 210,150 230,200 M 280,80 C 310,110 330,80 360,120 M 310,130 C 330,170 360,150 380,190 M 200,210 C 240,220 260,200 280,240' 
          fill='none' stroke='#94a3b8' stroke-width='1.8' stroke-linecap='round' opacity='0.5'/>

    <!-- Central Anatomical Labels / Core Focus Dot Rings -->
    <circle cx='200' cy='150' r='5' fill='#ef4444'/>
    <circle cx='320' cy='100' r='5' fill='#a855f7'/>
    <circle cx='385' cy='190' r='5' fill='#22c55e'/>
    <circle cx='240' cy='230' r='5' fill='#06b6d4'/>
    <circle cx='350' cy='320' r='5' fill='#ec4899'/>
    <circle cx='260' cy='340' r='5' fill='#f59e0b'/>
  </g>
</svg>